[Unit]
Description=PersonalAI first-party native inference data plane
Documentation=file:/usr/share/doc/personalai-engine/ADR-0006-always-offline-data-plane.md
After=local-fs.target
Requires=personalai-engine-release-verify.service
After=personalai-engine-release-verify.service
Before=shutdown.target
ConditionPathIsDirectory=/var/lib/personalai-engine/models

[Service]
Type=simple
User=personalai
Group=personalai
UMask=0077
EnvironmentFile=/etc/personalai-engine/engine.env
Environment=HOME=/nonexistent
UnsetEnvironment=AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN GOOGLE_APPLICATION_CREDENTIALS AZURE_CLIENT_ID AZURE_CLIENT_SECRET OPENAI_API_KEY HTTPS_PROXY HTTP_PROXY ALL_PROXY
LoadCredential=response.seed:/etc/personalai-engine/response.seed
StandardInput=file:/run/credentials/personalai-engine.service/response.seed
RuntimeDirectory=personalai-engine
RuntimeDirectoryMode=0700
ExecStart=/usr/lib/personalai-engine/release/personalai-engine serve-continuous --model-root /var/lib/personalai-engine/models --runtime-root /run/personalai-engine --socket /run/personalai-engine/engine.sock --model-id ${MODEL_ID} --package ${PACKAGE_NAME} --package-sha384 ${PACKAGE_HASH} --signer-key-id ${SIGNER_KEY_ID} --signer-public-key ${SIGNER_PUBLIC_KEY} --control-key-id ${CONTROL_KEY_ID} --control-public-key ${CONTROL_PUBLIC_KEY} --response-key-id ${RESPONSE_KEY_ID} --max-active-sequences ${MAXIMUM_ACTIVE} --max-connections ${MAXIMUM_CONNECTIONS} --max-memory-bytes ${MAXIMUM_MEMORY_BYTES} --max-kv-cache-bytes ${MAXIMUM_KV_CACHE_BYTES}
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3
TimeoutStopSec=45s
KillSignal=SIGTERM
LimitCORE=0
LimitNOFILE=1024
LimitNPROC=128
TasksMax=128
MemoryMax=16G
MemorySwapMax=0

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @privileged @resources @reboot @swap
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/var/lib/personalai-engine/models
ReadOnlyPaths=/usr/lib/personalai-engine/release
ReadWritePaths=/run/personalai-engine

[Install]
WantedBy=multi-user.target
